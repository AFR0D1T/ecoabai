# DOMAIN задаётся в .env (например eco-abai.kz или 1-2-3-4.sslip.io). Caddy сам выпустит и продлит HTTPS.
{$DOMAIN} {
	encode zstd gzip

	# API — тот же домен, поэтому httpOnly-cookie работают без CORS
	handle /api/* {
		request_body max_size 10MB
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/* /icons/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@nocache path / /index.html /sw.js /manifest.webmanifest /theme-init.js
	header @nocache Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://server.arcgisonline.com; connect-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}
