# Домен сайта. Нет своего — подойдёт бесплатный: <IP-с-дефисами>.sslip.io, например 203-0-113-10.sslip.io
DOMAIN=eco.example.kz
# Длинные случайные строки:  openssl rand -base64 48
SECRET_KEY=
POSTGRES_PASSWORD=
# true — заполнить пустую БД демо-данными (для показа); для реального запуска — false
SEED_DEMO=false
# пароль демо-аккаунтов (resident@test.kz, admin@test.kz …), обязателен при SEED_DEMO=true
DEMO_PASSWORD=
# первый администратор при чистом запуске
ADMIN_EMAIL=
ADMIN_PASSWORD=
