# dev | prod. В prod обязательно задать SECRET_KEY и COOKIE_SECURE=true (иначе сервер не стартует)
ECOABAI_ENV=dev
# 64+ случайных символов: python -c "import secrets; print(secrets.token_urlsafe(64))"
ECOABAI_SECRET_KEY=
# SQLite для разработки; для продакшена — Postgres:
# ECOABAI_DATABASE_URL=postgresql+psycopg://ecoabai:password@localhost:5432/ecoabai
ECOABAI_DATABASE_URL=sqlite:///./ecoabai.db
ECOABAI_COOKIE_SECURE=false
ECOABAI_ALLOWED_ORIGINS=["http://localhost:5173"]
ECOABAI_FRONTEND_URL=http://localhost:5173
ECOABAI_ACCESS_TTL_MINUTES=15
ECOABAI_REFRESH_TTL_DAYS=30
ECOABAI_UPLOAD_DIR=uploads
ECOABAI_MAX_UPLOAD_MB=8
# заполнить пустую БД демо-данными (в проде — false)
ECOABAI_SEED_DEMO=true
